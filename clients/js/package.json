{
  "name": "toll402-client",
  "version": "0.2.0",
  "description": "One-line client for Toll402 \u2014 pay-per-call tools for AI agents via x402 (USDC on Base). Free trial without a wallet; automatic payment with one.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://toll402.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toll402/toll402.git"
  },
  "keywords": [
    "agentkit",
    "ai-agents",
    "base",
    "coinbase-agentkit",
    "elizaos",
    "langchain",
    "mcp",
    "tools",
    "usdc",
    "vercel-ai",
    "x402"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./agentkit": {
      "types": "./dist/agentkit.d.ts",
      "import": "./dist/agentkit.js"
    },
    "./eliza": {
      "types": "./dist/eliza.d.ts",
      "import": "./dist/eliza.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx src/__smoke__.ts"
  },
  "dependencies": {
    "@x402/evm": "~2.25.0",
    "@x402/fetch": "~2.25.0",
    "viem": "^2.56.3"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "ai": ">=4.0.0",
    "zod": ">=3.23.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^0.3.0",
    "@types/node": "^22",
    "ai": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=20"
  }
}
